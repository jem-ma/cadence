# Copy to .env for local use, or add these as Environment Variables in Vercel.

# Required when hosted (Vercel): Postgres connection string (e.g. from Neon via the Vercel Marketplace)
# DATABASE_URL=postgres://...
# Required when hosted: 32+ random characters used to sign session cookies
# SESSION_SECRET=

# Optional: only people with this code can create accounts
# INVITE_CODE=

# Optional: AI coach's note and AI food estimates
# ANTHROPIC_API_KEY=
# CADENCE_AI_MODEL=claude-opus-5-5
# AI_DAILY_NOTES=6
# AI_DAILY_FOOD_ESTIMATES=40

# Local only
# HOST=127.0.0.1
# PORT=4321
